# Supabase public URL and anon key (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server (private)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Server
PORT=3001

# Google Gemini API key (optional)
GEMINI_API_KEY=

# Notes:
# - Do NOT commit your real secret keys. Put this file in repo as a template and
#   copy to `.env` with real values on deploy hosts or CI environment.# Frontend Supabase (Public)
VITE_SUPABASE_URL=http://localhost:3001/supabase-mock
VITE_SUPABASE_ANON_KEY=mock-anon-key-talenttrack-mvp

# Server (Private)
PORT=3001
SUPABASE_URL=http://localhost:3001/supabase-mock
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key-talenttrack-mvp

# Google Gemini AI Key (Optional - Falls back to high-fidelity built-in ATS heuristics if not set)
GEMINI_API_KEY=
